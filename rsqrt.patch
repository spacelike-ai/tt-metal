+    // Seed the Newton iteration below. For m = -val in [0.5, 1) the seed's relative error is
+    // -(a*m - 1)^2, so 4/3 is the minimax choice: it balances the ends of the mantissa range at
+    // 1/9, against 1/ln2's worst case of 0.196 as m approaches 1. The iteration squares the error
+    // each step, so that 1.76x carries to 9.7x after three iterations. Grayskull hardwired 1/ln2
+    // to avoid a load; Blackhole loads the immediate either way, so the better seed is free.
+    sfpi::vFloat seed   = 1.3333333f;
+    sfpi::vFloat two    = 2.0f;
+    sfpi::vFloat result = seed * (val * seed + two);
 
     for (int s_iter = 0; s_iter < (max_iter - 1); s_iter++)
     {
