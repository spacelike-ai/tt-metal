    [
      "^model\\.language_model\\.layers\\.([0-9]+)\\.mlp\\.gate_proj",
      "layers.\\1.ff.gate"
    ],
    [
      "^model\\.language_model\\.layers\\.([0-9]+)\\.mlp\\.up_proj",
      "layers.\\1.ff.linear_in"
    ],
    [
      "^model\\.language_model\\.layers\\.([0-9]+)\\.mlp\\.down_proj",
      "layers.\\1.ff.linear_out"
    ],
    [
      "^model\\.language_model\\.layers\\.([0-9]+)\\.post_attention_layernorm",
      "layers.\\1.ff_norm"
    ],
    [
      "^model\\.language_model\\.layers\\.([0-9]+)\\.input_layernorm",
      "layers.\\1.attn_norm"
    ],
    ["^model\\.language_model\\.norm\\.weight", "final_norm.weight"],
